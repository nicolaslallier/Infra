# Copy to .env and fill in real values. .env is gitignored.

# --- Postgres superuser / default DB ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# --- pgAdmin ---
PGADMIN_EMAIL=admin@infra.famillelallier.net
PGADMIN_PASSWORD=change-me

# --- Per-app databases ---
# Comma-separated list of app names. For each name "foo", a database "foo"
# and a role "foo" are created, owned by that role. Requires a matching
# FOO_DB_PASSWORD variable (uppercased app name) below.
APP_DATABASES=jarvis

JARVIS_DB_PASSWORD=change-me

# --- DNS (LAN-wide resolver for *.famillelallier.net, via Technitium) ---
# This machine's LAN IP. Used both as the address the dns container
# publishes its ports on, and as the answer it gives for
# infra.famillelallier.net / pgadmin.famillelallier.net. Get a static
# DHCP reservation for it from your router so it doesn't change.
LAN_IP=192.168.1.50

# Technitium web console ("http://<LAN_IP>:5380") admin password.
DNS_ADMIN_PASSWORD=change-me

# Upstream resolvers for every query that isn't a famillelallier.net
# name this stack owns. Defaults to Cloudflare if left unset.
UPSTREAM_DNS=1.1.1.1
UPSTREAM_DNS_2=1.0.0.1
