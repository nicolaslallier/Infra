# Copy to .env and fill in real values. .env is gitignored.

# --- Postgres superuser / default DB ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# --- pgAdmin ---
PGADMIN_EMAIL=admin@infra.famillelallier.net
PGADMIN_PASSWORD=change-me

# --- Keycloak ---
# Bootstrap admin account, created only on first boot against an empty
# Keycloak database (same first-run-only caveat as PGADMIN_EMAIL/PASSWORD
# above). Changing these later does not change an already-created admin.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# --- Per-app databases ---
# Comma-separated list of app names. For each name "foo", a database "foo"
# and a role "foo" are created, owned by that role. Requires a matching
# FOO_DB_PASSWORD variable (uppercased app name) below.
APP_DATABASES=jarvis,nurse,keycloak,grafana

JARVIS_DB_PASSWORD=change-me
NURSE_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me

# Read-only role for postgres-exporter (pg_monitor). Created on first boot
# by postgres/initdb/20-monitoring-role.sh; see README for existing clusters.
MONITORING_DB_PASSWORD=change-me

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- MinIO ---
# Root credentials for the object store (API + console). Password must be
# at least 8 characters. Created on first boot against an empty minio-data
# volume — changing these later does not rotate an already-initialized root.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# --- RabbitMQ ---
# Default user for AMQP + the management UI. Created on first boot against
# an empty rabbitmq-data volume — changing these later does not rotate an
# already-initialized user (use the management UI or rabbitmqctl instead).
RABBITMQ_DEFAULT_USER=infra
RABBITMQ_DEFAULT_PASS=change-me

# --- Nurse app: Keycloak realm "nurse" seed-user passwords ---
# Login passwords for the demo nurse.demo / examiner.demo accounts defined
# in keycloak/realm-import/nurse-realm.json. Set by
# `make keycloak-seed-users` (scripts/keycloak-seed-users.sh) once the
# keycloak service is up.
NURSE_SEED_PASSWORD=change-me
EXAMINER_SEED_PASSWORD=change-me

# --- DNS (LAN-wide resolver for *.famillelallier.net, via Technitium) ---
# This machine's LAN IP. Used both as the address the dns container
# publishes its ports on, and as the answer it gives for
# infra.famillelallier.net / pgadmin.famillelallier.net /
# keycloak.famillelallier.net. Get a static DHCP reservation for it from
# your router so it doesn't change.
LAN_IP=192.168.1.50

# Technitium web console ("http://<LAN_IP>:5380") admin password.
DNS_ADMIN_PASSWORD=change-me

# Upstream resolvers for every query that isn't a famillelallier.net
# name this stack owns. Defaults to Cloudflare if left unset.
UPSTREAM_DNS=1.1.1.1
UPSTREAM_DNS_2=1.0.0.1
