    {
      "type": "timeseries",
      "title": "Latence p50 / p95",
      "description": "Requêtes réussies. request_duration_ms, sinon endTime - startTime.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "litellm-db"
      },
      "interval": "5m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "litellm-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(\"startTime\", $__interval),\n       percentile_cont(0.5)  WITHIN GROUP (ORDER BY d) AS \"p50\",\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY d) AS \"p95\"\nFROM (SELECT \"startTime\", COALESCE(request_duration_ms, EXTRACT(EPOCH FROM (\"endTime\" - \"startTime\")) * 1000)::float8 AS d\n      FROM \"LiteLLM_SpendLogs\"\n      WHERE $__timeFilter(\"startTime\")\n  AND COALESCE(NULLIF(model_group, ''), '(aucun)') IN (${model_group:sqlstring})\n  AND COALESCE(NULLIF(team_id, ''), '(aucune)') IN (${team_id:sqlstring})\n        AND COALESCE(status, 'success') = 'success') s\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
