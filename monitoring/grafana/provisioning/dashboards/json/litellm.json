    {
      "type": "timeseries",
      "title": "Requêtes / min par modèle",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "litellm-db"
      },
      "interval": "5m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "litellm-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(\"startTime\", $__interval, 0),\n       COALESCE(NULLIF(model_group, ''), '(aucun)') AS metric,\n       count(*) * 60000.0 / $__interval_ms AS value\nFROM \"LiteLLM_SpendLogs\"\nWHERE $__timeFilter(\"startTime\")\n  AND COALESCE(NULLIF(model_group, ''), '(aucun)') IN (${model_group:sqlstring})\n  AND COALESCE(NULLIF(team_id, ''), '(aucune)') IN (${team_id:sqlstring})\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
