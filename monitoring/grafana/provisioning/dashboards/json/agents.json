    {
      "type": "stat",
      "title": "Erreurs dans les logs (période)",
      "description": "Lignes de log de niveau erreur sur la période affichée. Loki ne lit que les conteneurs du homelab : une instance d'agent sur le Mac Studio ou le Mac mini n'y figure pas.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({compose_project=\"darkangel\", compose_service=\"darkangel-api\"} |~ \"^(ERROR|CRITICAL):\" [$__range])) or vector(0)",
          "legendFormat": "DarkAngel",
          "refId": "A",
          "queryType": "instant",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({compose_project=\"jarvis\"} |~ \"(?i)\\\\b(error|critical|fatal)\\\\b\" [$__range])) or vector(0)",
          "legendFormat": "Jarvis",
          "refId": "B",
          "queryType": "instant",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({compose_project=\"ea\", compose_service=\"api\"} | json | __error__=\"\" | level=~\"ERROR|CRITICAL\" [$__range])) or vector(0)",
          "legendFormat": "EA",
          "refId": "C",
          "queryType": "instant",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({compose_project=\"librechat\", compose_service=\"api\"} |~ \"(\\\\x1b\\\\[\\\\d+m)?error(\\\\x1b\\\\[\\\\d+m)?:\" [$__range])) or vector(0)",
          "legendFormat": "LibreChat",
          "refId": "D",
          "queryType": "instant",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({compose_project=\"platform\", compose_service=~\"litellm|litellm-pgvector\"} |~ \"(?i)\\\\b(error|exception|traceback)\\\\b\" != \"/health\" [$__range])) or vector(0)",
          "legendFormat": "LiteLLM",
          "refId": "E",
          "queryType": "instant",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({compose_project=\"platform\", compose_service=~\"prefect-.+\"} |~ \"\\\\| (ERROR|CRITICAL) \" [$__range])) or vector(0)",
          "legendFormat": "Prefect",
          "refId": "F",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
