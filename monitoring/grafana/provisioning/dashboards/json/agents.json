    {
      "type": "stat",
      "title": "Conteneurs en marche",
      "description": "Conteneurs de chaque agent vus par cAdvisor dans les 90 dernières secondes, sur le homelab et les VM Colima (Mac Studio, Mac mini). 0 = l'agent est arrêté.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(time() - container_last_seen{name=~\"darkangel-.+\"} < 90) or vector(0)",
          "legendFormat": "DarkAngel",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(time() - container_last_seen{name=~\"jarvis-.+\"} < 90) or vector(0)",
          "legendFormat": "Jarvis",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(time() - container_last_seen{name=~\"ea-(api|web)-[0-9]+\"} < 90) or vector(0)",
          "legendFormat": "EA",
          "refId": "C",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(time() - container_last_seen{name=~\"LibreChat|admin-panel|chat-mongodb|chat-meilisearch|vectordb|rag_api|librechat-.+\"} < 90) or vector(0)",
          "legendFormat": "LibreChat",
          "refId": "D",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(time() - container_last_seen{name=~\"platform-litellm-[0-9]+|platform-presidio-.+|platform-litellm-pgvector-[0-9]+\"} < 90) or vector(0)",
          "legendFormat": "LiteLLM",
          "refId": "E",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(time() - container_last_seen{name=~\"platform-prefect-.+\"} < 90) or vector(0)",
          "legendFormat": "Prefect",
          "refId": "F",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(time() - container_last_seen{name=~\"(platform|infra)-ollama-proxy.*\"} < 90) or vector(0)",
          "legendFormat": "Ollama",
          "refId": "G",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
