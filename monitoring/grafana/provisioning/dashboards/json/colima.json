  "templating": {
    "list": [
      {
        "type": "query",
        "name": "instance",
        "label": "VM",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{job=\"colima-node\"}, instance)",
        "definition": "label_values(up{job=\"colima-node\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
