{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "enabledManagers": [
    "docker-compose",
    "dockerfile"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)docker-compose[^/]*\\.ya?ml$/"
    ]
  },
  "schedule": [
    "before 6am on saturday"
  ],
  "prConcurrentLimit": 3,
  "automerge": false,
  "ignoreDeps": [
    "infra-ollama-proxy",
    "myoung34/github-runner",
    "devbox-session",
    "dev-egress",
    "dev-gateway"
  ],
  "packageRules": [
    {
      "description": "Store-format images (pgvector, openbao, seaweedfs) are bumped across majors by hand, never by Renovate.",
      "matchPackageNames": [
        "pgvector/pgvector",
        "openbao/openbao",
        "chrislusf/seaweedfs"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ],
  "dockerfile": {
    "managerFilePatterns": [
      "/(^|/)dev/[^/]+/Dockerfile$/"
    ]
  }
}
